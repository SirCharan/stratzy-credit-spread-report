{
  "redirects": [
    { "source": "/credit-spreads", "destination": "/", "permanent": false },
    { "source": "/explore", "destination": "/", "permanent": false },
    { "source": "/compare", "destination": "/#/compare", "permanent": false },
    { "source": "/equity", "destination": "/#/studio?sub=charts", "permanent": false },
    { "source": "/what-if", "destination": "/#/studio?sub=charts&tab=whatif", "permanent": false },
    { "source": "/option-buying", "destination": "/#/playbook?sub=guide", "permanent": false },
    { "source": "/option-buying-guide", "destination": "/#/playbook?sub=guide", "permanent": false },
    { "source": "/option-buying-portfolio", "destination": "/#/studio?sub=portfolio", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*).(json|csv)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
